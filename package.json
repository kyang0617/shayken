{
	"name": "shayken",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"deploy": "wrangler deploy",
		"build:client": "esbuild client/main.ts --bundle --format=esm --target=es2022 --outfile=public/main.js",
		"check": "tsc --noEmit && tsc --noEmit -p client",
		"cf-typegen": "wrangler types",
		"test:e2e": "node test/e2e.mjs",
		"dev:reap": "wrangler dev --var REAP_EMPTY_SECONDS:2 --var REAP_SOLO_SECONDS:4",
		"test:reap": "node test/reap.mjs"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"wrangler": "^4.152.0"
	}
}
