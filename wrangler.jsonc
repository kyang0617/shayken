{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "play",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Static frontend served by the same Worker. Requests matching a file in ./public are served
  // directly (free, no Worker invocation); only /api/* runs our code.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  // Bundle client/main.ts -> public/main.js before `wrangler dev`/`deploy`, and rebuild on change.
  "build": {
    "command": "npm run build:client",
    "watch_dir": ["client", "shared"]
  },
  // Room reaping timings. Override locally for tests, e.g.
  // `wrangler dev --var REAP_EMPTY_SECONDS:2 --var REAP_SOLO_SECONDS:4`.
  "vars": {
    "REAP_EMPTY_SECONDS": "60", // no players connected (grace period so a refresh doesn't kill the room)
    "REAP_SOLO_SECONDS": "600" // only one player connected
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GameRoom",
        "name": "GAME_ROOM"
      }
    ]
  },
  // The free plan only allows SQLite-backed Durable Objects, declared via new_sqlite_classes.
  // Never edit an applied migration; add a new tag instead (this one has never been deployed).
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
